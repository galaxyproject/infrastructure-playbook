server {
    listen      *:443 ssl;
    server_name depot.galaxyproject.org;

    access_log  /var/log/nginx/depot.galaxyproject.org_access.log;
    error_log   /var/log/nginx/depot.galaxyproject.org_error.log;

    client_max_body_size 256M;

    root        /srv/nginx/depot.galaxyproject.org/root;

    location / {
        autoindex   on;
    }

    location /singularity/ {
        alias       /srv/nginx/depot.galaxyproject.org/singularity/;
        autoindex   on;
    }

    # IWC test data mirror (galaxyproject/iwc scripts/sync_test_data.py), files are
    # addressed by content hash and never change; planemo --test_data_mirror looks them up.
    # Files are sharded as <algo>/<first 2 hex chars>/<hash>. Only the files match, directory
    # listings and manifest.json fall through to / (autoindex, uncached).
    location ~ "^/iwc-test-data/(md5|sha1|sha256|sha512)/[0-9a-f]{2}/[0-9a-f]+$" {
        expires         max;
        default_type    application/octet-stream;
    }

    location /patch {
        autoindex   off;
        try_files   $uri =403;
    }

    location ~ /(.*\.ova) {
        return 302 https://images.galaxyproject.org/gcc/$1;
    }
}

# vim: set filetype=nginx
