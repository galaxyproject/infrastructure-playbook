# nginx >= 1.29.7 keeps idle HTTP/1.1 connections to upstreams for 60 s by default. gunicorn closes them after its 2 s
# --keep-alive, and requests nginx sends on a connection gunicorn is closing fail ("upstream prematurely closed"), with
# a 502 for POSTs. keepalive 0 restores nginx 1.20's behaviour of one connection per request.
upstream galaxy_staging {
    least_conn;
    keepalive 0;
    # isolated failures must not mark both gunicorns down for fail_timeout ("no live upstreams")
    server 127.0.0.1:8080 max_fails=10 fail_timeout=10s;
    server 127.0.0.1:8081 max_fails=10 fail_timeout=10s;
}

server {
    listen       *:8000;

    access_log  /var/log/nginx/staging-lb.access.log;
    error_log   /var/log/nginx/staging-lb.error.log;

    # This server forwards the client's Host and X-Forwarded-* headers as received, so only the load balancer may use it
{% for name in groups['galaxy_main_load_balancers'] %}
    allow {{ lookup('dig', name) }};
{% endfor %}
    deny all;

    set $gx_host                $http_host;
    set $gx_x_real_ip           $http_x_real_ip;
    set $gx_x_forwarded_for     $http_x_forwarded_for;
    set $gx_x_forwarded_proto   $http_x_forwarded_proto;

    include {{ nginx_conf_dir }}/usegalaxy_staging_proxy.conf;
}

server {
    listen       *:443 ssl http2;
    server_name  staging.usegalaxy.org;

    # Enable HSTS (age is 180 days)
    add_header Strict-Transport-Security "max-age=15552000; includeSubdomains";

    access_log  /var/log/nginx/staging-direct.access.log;
    error_log   /var/log/nginx/staging-direct.error.log;

    set $gx_host                $host;
    set $gx_x_real_ip           $remote_addr;
    set $gx_x_forwarded_for     $remote_addr;
    set $gx_x_forwarded_proto   $scheme;

    include {{ nginx_conf_dir }}/usegalaxy_staging_proxy.conf;
}

