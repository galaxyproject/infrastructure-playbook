#!/usr/bin/env bash
# set -eo pipefail not used here because removals in scratch dirs while running cause find to exit nonzero
set -u

LOG="{{ galaxy_log_dir }}/cleanup_daily-$(date +%Y-%m-%d).log"
# flock on a local file: released by the kernel even if this script is killed
LOCK="${TMPDIR:-/tmp}/galaxy-clean-$(id -un).lock"

exec 9>"$LOCK"
if ! flock -n 9; then
    echo "$(date): Galaxy cleanup on $(hostname -s) is still running from a previous run (lock: $LOCK), skipping" \
        | tee -a "$LOG" >&2
    exit 1
fi

{
    set -x;
{% for job in galaxy_cleanup_jobs %}
    {{ job }};
{% endfor %}
    { set +x; } 2>/dev/null;
} >> "$LOG" 2>&1
